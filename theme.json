{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "primary",
					"color": "#0d1b4b",
					"name": "Primary"
				},
				{
					"slug": "accent",
					"color": "#3dffa0",
					"name": "Accent"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.5rem", "name": "X Large" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--primary)",
			"text": "var(--wp--preset--color--white)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#0d1b4b"
				},
				"typography": {
					"fontWeight": "700"
				},
				"border": {
					"radius": "4px"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontWeight": "800"
				}
			}
		}
	}
}